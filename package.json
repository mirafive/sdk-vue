{
  "name": "@mirafive/vue",
  "version": "2.0.2",
  "description": "MIRA FIVE for Vue 3: a plugin, useMira() and useIdentify() over @mirafive/web. SSR-safe, no dependencies beyond MIRA FIVE's own.",
  "keywords": [
    "analytics",
    "attribution",
    "consent",
    "mira-five",
    "mirafive",
    "plugin",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/mirafive/sdk-vue#readme",
  "bugs": {
    "url": "https://github.com/mirafive/sdk-vue/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-vue.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@mirafive/web": "^2.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "packageManager": "bun@1.4.4"
}
